{
  "name": "pitworld",
  "version": "0.11.0",
  "mcpName": "world.pit/pit",
  "description": "pit.world MCP server: private web search and Moshpit name lookups for AI agents (stdio, no API key). Also a web app, API, CLI and TUI.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://pit.world",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moshcoder/pit.world.git"
  },
  "bin": {
    "pit": "bin/pit"
  },
  "files": [
    "bin/pit",
    "src",
    "public",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.1"
  },
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun --watch src/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@profullstack/affiliates": "0.2.0",
    "@profullstack/bridges": "0.2.0",
    "@profullstack/footer": "0.4.0",
    "@profullstack/hqtui": "^0.11.0",
    "@profullstack/openprofile": "0.2.0",
    "@profullstack/redeem-credits": "0.1.0",
    "@profullstack/x402-gateway": "^0.13.1",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "search",
    "private search",
    "moshpit",
    "dns",
    "mcp",
    "cli",
    "tui",
    "mcp server",
    "model context protocol",
    "web search mcp"
  ]
}
