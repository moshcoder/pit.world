{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "world.pit/pit",
  "title": "pit.world MCP server",
  "description": "MCP server for private web search (no API key) and Moshpit name lookups. No logs, no cookies.",
  "websiteUrl": "https://pit.world",
  "repository": {
    "url": "https://github.com/moshcoder/pit.world",
    "source": "github"
  },
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "pitworld",
      "version": "0.2.0",
      "runtimeHint": "bunx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "Run the stdio MCP server"
        }
      ],
      "environmentVariables": [
        {
          "name": "PIT_URL",
          "description": "pit.world instance to query (default https://pit.world)",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "default": "https://pit.world"
        }
      ]
    }
  ]
}
